{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/New_York",
  "kubernetes": {
    "managerFilePatterns": [
      "kubernetes/**/*.yaml",
      "kubernetes/**/*.yml"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "kubernetes"
      ],
      "matchFileNames": [
        "kubernetes/clusters/liberty/flux-system/**"
      ],
      "enabled": false
    }
  ]
}
